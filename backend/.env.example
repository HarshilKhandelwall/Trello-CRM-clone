# ── Django Core ───────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here
DJANGO_DEBUG=False

# ── Hosts & Origins ───────────────────────────────────────────────────────────
# Comma-separated list of allowed hosts (no spaces)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,166.0.244.228,crm.welinkglobalsolutions.com

# Comma-separated CORS origins (include http:// or https://)
DJANGO_CORS_ALLOWED_ORIGINS=http://166.0.244.228,https://crm.welinkglobalsolutions.com

# Extra CSRF trusted origins (same format as CORS, add if needed)
DJANGO_CSRF_TRUSTED_ORIGINS=http://166.0.244.228,https://crm.welinkglobalsolutions.com

# ── Database ──────────────────────────────────────────────────────────────────
DJANGO_DB_ENGINE=django.db.backends.sqlite3
# Leave empty to use default path (backend/db.sqlite3)
DJANGO_DB_NAME=

# ── Channels / WebSocket ──────────────────────────────────────────────────────
# Use 'memory' (single server) or 'redis' (multi-server / production)
DJANGO_CHANNEL_BACKEND=memory
DJANGO_REDIS_URL=redis://localhost:6379/0

# ── Email / OTP ───────────────────────────────────────────────────────────────
# The email address that will RECEIVE every login OTP (your admin inbox).
SUPERADMIN_OTP_EMAIL=your-admin-email@example.com

# SMTP server settings (Gmail defaults shown — change if using another provider).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# The Gmail / SMTP account that SENDS the OTP emails.
EMAIL_HOST_USER=your-sending-address@gmail.com

# For Gmail: generate an App Password at https://myaccount.google.com/apppasswords
# (2-Step Verification must be enabled on the account first)
EMAIL_HOST_PASSWORD=your-app-password-here

# Leave this unset (or remove the line) to use the real SMTP backend.
# Set to 'django.core.mail.backends.console.EmailBackend' ONLY for local dev/CI
# where you want OTPs printed to the terminal instead of emailed.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
