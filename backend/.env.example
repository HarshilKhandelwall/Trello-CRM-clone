DJANGO_SECRET_KEY=replace-this-with-a-secure-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com
DJANGO_CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Database (override defaults from settings.py if needed)
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=your_db_name
DJANGO_DB_USER=your_db_user
DJANGO_DB_PASSWORD=your_db_password
DJANGO_DB_HOST=your_db_host
DJANGO_DB_PORT=5432

# Channels / Redis
DJANGO_CHANNEL_BACKEND=redis
DJANGO_REDIS_URL=redis://redis:6379/0

# Third-party services
SENDGRID_API_KEY=replace-with-your-sendgrid-api-key
